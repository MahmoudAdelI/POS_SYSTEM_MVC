@model POS_SYSTEM_MVC.DTOs.Dashboard.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-4">
    <h4 class="fw-bold mb-1">Dashboard</h4>
    <p class="text-muted mb-4">Welcome back! Here's what's happening with your store.</p>

    
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="bg-primary bg-opacity-10 rounded-2 p-2">
                        <i class="fas fa-dollar-sign text-primary"></i>
                    </div>
                    <span class="text-success small fw-semibold">↑ @Model.SalesGrowth%</span>
                </div>
                <h5 class="fw-bold mt-3 mb-0">$@Model.TotalSales.ToString("N2")</h5>
                <p class="text-muted small mb-0">Total Sales</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="bg-success bg-opacity-10 rounded-2 p-2">
                        <i class="fas fa-shopping-cart text-success"></i>
                    </div>
                    <span class="text-success small fw-semibold">↑ @Model.OrdersGrowth%</span>
                </div>
                <h5 class="fw-bold mt-3 mb-0">@Model.TotalOrders</h5>
                <p class="text-muted small mb-0">Orders</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="bg-purple bg-opacity-10 rounded-2 p-2"
                         style="background-color:#EEEDFE !important">
                        <i class="fas fa-box" style="color:#534AB7"></i>
                    </div>
                </div>
                <h5 class="fw-bold mt-3 mb-0">@Model.TotalProducts</h5>
                <p class="text-muted small mb-0">Products</p>
            </div>
        </div>
    </div>

    
    <div class="card border-0 shadow-sm rounded-3 p-4 mb-4">
        <h5 class="fw-bold mb-3">Recent Sales</h5>
        <div class="table-responsive">
            <table class="table table-borderless align-middle">
                <thead class="text-muted small">
                    <tr>
                        <th>Product</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model.RecentSales)
                    {
                        <tr>
                            <td class="fw-medium">@sale.ProductName</td>
                            <td>$@sale.Amount.ToString("N2")</td>
                            <td>
                                @if (sale.Status == "Completed")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#EAF3DE;color:#3B6D11">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#FAEEDA;color:#854F0B">
                                        @sale.Status
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">@sale.Date.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

   
    <div class="card border-0 shadow-sm rounded-3 p-4 mb-4">
        <h5 class="fw-bold mb-3">Top Products</h5>
        @foreach (var product in Model.TopProducts)
        {
            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width:32px;height:32px;background:#E6F1FB;color:#185FA5;font-size:13px;flex-shrink:0">
                    @product.Rank
                </div>
                <div class="flex-grow-1">
                    <p class="mb-0 fw-medium">@product.ProductName</p>
                    <p class="mb-0 text-muted small">@product.UnitsSold sold</p>
                </div>
                <span class="fw-semibold">$@product.TotalRevenue.ToString("N2")</span>
            </div>
        }
    </div>

    
    <div class="card border-0 shadow-sm rounded-3 p-4">
        <h5 class="fw-bold mb-3">Sales Overview</h5>
        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
            <i class="fas fa-chart-bar fa-2x mb-2"></i>
            <p class="mb-0 small">Sales chart visualization would go here</p>
        </div>
    </div>
</div>