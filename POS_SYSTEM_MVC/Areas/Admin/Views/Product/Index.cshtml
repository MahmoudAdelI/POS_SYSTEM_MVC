@using POS_SYSTEM_MVC.ViewModels
@model CreateProductViewModel
@{
    ViewData["Title"] = "Add New Product";
    // Dropdown data – in reality, populate these from the controller
    var brands = ViewBag.Brands as SelectList;
    var categories = ViewBag.Categories as SelectList;
    var units = ViewBag.Units as SelectList;
}

<div class="mx-5 p-5">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form enctype ="multipart/form-data" class="bg-white rounded shadow-sm border p-4">
        @Html.AntiForgeryToken()
        <!-- Basic Product Info -->
        <div class="row g-3 mb-4">
                <div class="">
                    <label class="form-label">Product Image</label>
                    <div class="d-flex align-items-start gap-3">
                        <div class="upload-box" id="uploadBox" title="Click to upload image">
                            <input type="file" id="imageInput" name="ProductImage" accept="image/*" />
                            <img id="imagePreview" alt="Preview" />
                            <button type="button" class="remove-btn" id="removeImageBtn" title="Remove image">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                            <span class="plus-icon"><i class="fa-solid fa-plus"></i></span>
                            <span class="upload-label-text">Upload image</span>
                        </div>
                    </div>
                </div>
            <div class="col-md-6">
                <label class="form-label">Product Name</label>
                <input class="form-control" id="productName" placeholder="Enter product name" />
                <span class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Brand</label>
                <div class="input-group">
                    <select id="brandSelect" class="form-select" required>
                        <option value="">Select brand</option>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-secondary ms-1 add-new-btn" data-target="brandSelect" data-modal="brand">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <span class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Category</label>
                <div class="input-group">
                <select class="form-select" id="categorySelect" required>
                    <option value="">Select category</option>
                    @foreach(var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                    <button type="button" class="btn btn-outline-secondary ms-1 add-new-btn" data-target="categorySelect" data-modal="category">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
                <span class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Subcategory</label>
                <div class="input-group">
                <select class="form-select" id="subcategorySelect" disabled>
                    <option value="">Select subcategory</option>
                </select>
                    <button type="button" class="btn btn-outline-secondary ms-1 add-new-btn"
                    data-target="subcategorySelect" 
                    data-modal="subcategory"
                    data-parent-id="categorySelect"
                    data-parent-key="categoryId"
                    disabled>
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
                <span class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Unit</label>
                <div class="input-group">
                <select class="form-select" id="unitSelect" required>
                    <option value="">Select unit</option>
                    @foreach(var u in Model.Units)
                    {
                    <option value="@u.Id">@u.Name</option>
                    }
                </select>
                    <button type="button" class="btn btn-outline-secondary ms-1 add-new-btn" data-target="unitSelect" data-modal="unit">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
                <span class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Base Price ($)</label>
                <input type="number" step="0.01" class="form-control" id="BasePriceSelect" placeholder="0.00" />
                <span class="text-danger small"></span>
            </div>
        </div>

        <!-- Product Variants Section -->
        <div class="border-top pt-4 mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Product Variants</h5>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-2" id="addAttributeBtn">
                    <i class="fa-solid fa-plus"></i>
                    Add Attribute
                </button>
            </div>
        </div>

            <!-- Empty State Placeholder -->
            <div id="emptyAttributesPlaceholder" class="text-center py-3 bg-light rounded-4 border border-1 border-dashed border-secondary">
                <p class="text-muted mb-2">No attributes added yet</p>
                <p class="small text-secondary">Click "Add Attribute" to define product variations</p>
            </div>


            <!-- Attributes Container (initially hidden) -->
            <div id="attributesContainer" class="d-none">
                <!-- Attribute groups will be added here dynamically -->
                
            </div>

            <!-- Generated Variants Table (initially hidden) -->
        <div id="variantsSection" class="border-top pt-4 mt-4 d-none">
            
            </div>

        <!-- Form Actions -->
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="reset" class="btn btn-outline-secondary">Clear</button>
            <button type="submit" class="btn btn-primary">Add Product</button>
        </div>
    </form>
</div>
<div class="modal fade" id="genericModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="genericModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="genericModalBody">
                <!-- fields injected by JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="genericModalSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script>
        const imgInput = document.getElementById('imageInput');
    const imgPreview = document.getElementById('imagePreview');
    const uploadBox = document.getElementById('uploadBox');
    const removeImageBtn = document.getElementById('removeImageBtn');

    imgInput.addEventListener('change', () => {
        const file = imgInput.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => {
            imgPreview.src = e.target.result;
            uploadBox.classList.add('has-image');
        };
        reader.readAsDataURL(file);
    });

    removeImageBtn.addEventListener('click', e => {
        e.stopPropagation();
        imgPreview.src = '';
        imgInput.value = '';
        uploadBox.classList.remove('has-image');
    });
</script>

@* Bind SubCategories to Categories *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Embed the categories with their subcategories as a JavaScript object
        const categoriesData = @Html.Raw(Json.Serialize(Model.Categories));

        document.getElementById('categorySelect').addEventListener('change', function() {
            const categoryId = parseInt(this.value);
            const subSelect = document.getElementById('subcategorySelect');
            const addSubCategoryBtn = document.querySelector("[data-modal='subcategory']")
            // Clear current options
            subSelect.innerHTML = '<option value="">Select subcategory</option>';

            if (!categoryId) {
                subSelect.disabled = true;
                return;
            }

            // Find the selected category in our embedded data
            const category = categoriesData.find(c => c.id === categoryId);
            category?.subCategories?.forEach(sub => {
                    subSelect.innerHTML += `<option value="${sub.id}">${sub.name}</option>`;
                });
            subSelect.disabled = false;
            addSubCategoryBtn.disabled = false;
        });
    </script>
    <script src="~/js/addProduct.js" type="module"></script>
}