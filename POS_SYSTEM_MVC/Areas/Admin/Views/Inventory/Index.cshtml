@model POS_SYSTEM_MVC.DTOs.Inventory.InventoryDto
@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var search = ViewData["Search"] as string ?? "";
}

<div class="p-4">
    <h4 class="fw-bold mb-1">Inventory Management</h4>
    <p class="text-muted mb-4">Monitor stock levels and manage inventory</p>

    <!-- Stat Cards-->
    <div class="row g-3 mb-4">

        <!-- Total Products-->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <div class="mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#EEF2FF;">
                        <i class="fas fa-box" style="color:#4F6EF7;font-size:1.2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-0">@Model.TotalProducts</h4>
                <p class="text-muted small mb-0">Total Products</p>
            </div>
        </div>

        <!-- Low Stock-->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <div class="mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#FEF9C3;">
                        <i class="fas fa-arrow-trend-down" style="color:#B45309;font-size:1.2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-0">@Model.LowStockItems</h4>
                <p class="text-muted small mb-0">Low Stock Items</p>
            </div>
        </div>

        <!-- Out of Stock-->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <div class="mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#FEE2E2;">
                        <i class="fas fa-triangle-exclamation" style="color:#DC2626;font-size:1.2rem;"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-0">@Model.OutOfStockItems</h4>
                <p class="text-muted small mb-0">Out of Stock Items</p>
            </div>
        </div>

    </div>

    <!-- Search-->
    <div class="card border-0 shadow-sm rounded-3 p-3 mb-4">
        <form method="get" asp-action="Index" asp-controller="Inventory" asp-area="Admin">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control border-start-0 ps-0"
                       placeholder="Search products..."
                       style="box-shadow:none;" />
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="Index" asp-area="Admin" asp-controller="Inventory"
                       class="btn btn-outline-secondary border-start-0">
                        <i class="fas fa-xmark"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Products Table-->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-borderless align-middle mb-0">
                <thead style="background:#F8F9FA;">
                    <tr class="text-muted small">
                        <th class="px-4 py-3 fw-semibold">Product</th>
                        <th class="py-3 fw-semibold">Category</th>
                        <th class="py-3 fw-semibold">Total Stock</th>
                        <th class="py-3 fw-semibold">Variants</th>
                        <th class="py-3 fw-semibold">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-2x mb-2 d-block"></i>
                                No products found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            <tr class="border-top">
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if(product.ImageUrl != null)
                                        {
                                            <div class="rounded-3 overflow-hidden flex-shrink-0"
                                                 style="width:48px;height:48px;background:#F1F5F9;">
                                                <img src="@product.ImageUrl" alt="Alternate Text" class="w-100 h-100 object-fit-cover" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width:48px;height:48px;background:#F1F5F9;">
                                                <i class="fas fa-box text-secondary"></i>
                                            </div>
                                        }
                                        <div>
                                            <p class="mb-0 fw-semibold">@product.ProductName</p>
                                            <p class="mb-0 text-muted small">@product.BrandName</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 text-muted">@product.CategoryName</td>
                                <td class="py-3">
                                    <span class="fw-medium">@product.TotalStock</span>
                                    <span class="text-muted small ms-1">units</span>
                                </td>
                                <td class="py-3 text-muted">@product.VariantsCount variants</td>
                                <td class="py-3">
                                    <span class="badge rounded-pill px-3 py-2 small fw-semibold"
                                          style="@product.StatusBadgeStyle">
                                        @product.StatusLabel
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
