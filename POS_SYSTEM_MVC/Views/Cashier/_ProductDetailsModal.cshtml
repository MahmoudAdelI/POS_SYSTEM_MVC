@model POS_SYSTEM_MVC.Models.Product

<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Product Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-5">
                        <img src="/images/products/@(Model.Id).jpg" class="img-fluid rounded-4 shadow-sm" alt="@Model.Name" onerror="this.onerror=null; this.src='https://via.placeholder.com/400x400?text=@(Uri.EscapeDataString(Model.Name))'">
                    </div>
                    <div class="col-md-7 ps-md-4 mt-3 mt-md-0">
                        <h2 class="fw-bold mb-1">@Model.Name</h2>
                        <p class="text-muted mb-3">@Model.Brand?.Name</p>
                        
                        <h3 class="text-primary fw-bold mb-4" id="displayPrice">$@Model.BasePrice.ToString("F2")</h3>

                        @{
                            var attributes = Model.Variants
                                .SelectMany(v => v.VariantAttributes)
                                .GroupBy(va => va.AttributeValue.Attribute.Name)
                                .ToList();
                        }

                        @foreach (var attrGroup in attributes)
                        {
                            <div class="mb-3">
                                <label class="fw-bold mb-2">@attrGroup.Key</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var val in attrGroup.Select(v => v.AttributeValue.Value).Distinct())
                                    {
                                        var uniqueId = $"val_{attrGroup.Key.Replace(" ", "_")}_{val.Replace(" ", "_")}";
                                        <input type="radio" class="btn-check attr-radio" name="attr_@attrGroup.Key" id="@uniqueId" value="@val" autocomplete="off" onchange="updateVariantDetails()">
                                        <label class="btn btn-outline-secondary px-3 py-1 rounded-3" for="@uniqueId">@val</label>
                                    }
                                </div>
                            </div>
                        }

                        <div class="row mt-4 align-items-center">
                            <div class="col-6">
                                <span class="text-muted d-block small">Stock Available</span>
                                <span class="fw-bold" id="displayStock">Select options</span>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted d-block small text-end">SKU</span>
                                <span class="text-dark fw-bold small" id="displaySKU">-</span>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="fw-bold mb-2">Quantity</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="input-group" style="width: 140px;">
                                    <button class="btn btn-outline-secondary border-1" type="button" onclick="changeQty(-1)"><i class="fas fa-minus"></i></button>
                                    <input type="text" id="qtyInput" class="form-control text-center bg-white" value="1" readonly>
                                    <button class="btn btn-outline-secondary border-1" type="button" onclick="changeQty(1)"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-primary w-100 py-3 fw-bold rounded-3" id="addToCartBtn" disabled onclick="addToCart()">
                                Add to Cart - <span id="totalPriceDisplay">$@Model.BasePrice.ToString("F2")</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        // Use var for redeclaration safety in AJAX-loaded partials
        var variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new {
            id = v.Id,
            price = v.UnitPrice,
            stock = v.StockQuantity,
            sku = v.SKU,
            attributes = v.VariantAttributes.ToDictionary(va => va.AttributeValue.Attribute.Name, va => va.AttributeValue.Value)
        })));

        var totalAttrsCount = @attributes.Count;
        
        // Reset global selection state
        window.selectedVariantId = null;
        window.currentUnitPrice = null;

        window.updateVariantDetails = function() {
            var selections = {};
            $('.attr-radio:checked').each(function() {
                var attrName = $(this).attr('name').replace('attr_', '');
                selections[attrName] = $(this).val();
            });

            var selectedCount = Object.keys(selections).length;

            if (selectedCount === totalAttrsCount) {
                var variant = variants.find(function(v) {
                    return Object.entries(selections).every(function(entry) {
                        return v.attributes[entry[0]] === entry[1];
                    });
                });

                if (variant) {
                    $('#displayPrice').text('$' + variant.price.toFixed(2));
                    $('#displaySKU').text(variant.sku);
                    $('#totalPriceDisplay').text('$' + (variant.price * parseInt($('#qtyInput').val())).toFixed(2));
                    
                    if (variant.stock <= 0) {
                        $('#displayStock').text('Out of stock').removeClass('text-success').addClass('text-danger');
                        $('#addToCartBtn').prop('disabled', true).addClass('btn-secondary').removeClass('btn-primary');
                    } else {
                        $('#displayStock').text(variant.stock + ' units').removeClass('text-danger').addClass('text-success');
                        $('#addToCartBtn').prop('disabled', false).addClass('btn-primary').removeClass('btn-secondary');
                    }
                    
                    window.selectedVariantId = variant.id;
                    window.currentUnitPrice = variant.price;
                } else {
                    resetVariantDetails();
                }
            } else {
                resetVariantDetails();
            }
        };

        function resetVariantDetails() {
            $('#displayStock').text('Select options').removeClass('text-danger text-success');
            $('#displaySKU').text('-');
            $('#addToCartBtn').prop('disabled', true);
            window.selectedVariantId = null;
            window.currentUnitPrice = null;
        }

        window.changeQty = function(amt) {
            var current = parseInt($('#qtyInput').val());
            current += amt;
            if (current < 1) current = 1;
            
            var stockText = $('#displayStock').text();
            if (stockText.includes('units')) {
                var stock = parseInt(stockText);
                if (current > stock) current = stock;
            }

            $('#qtyInput').val(current);
            if (window.currentUnitPrice) {
                $('#totalPriceDisplay').text('$' + (window.currentUnitPrice * current).toFixed(2));
            }
        };

        window.addToCart = function() {
            if (!window.selectedVariantId) return;
            
            var qty = parseInt($('#qtyInput').val());
            var variant = variants.find(v => v.id === window.selectedVariantId);
            
            var existingItem = window.posCart.find(i => i.variantId === window.selectedVariantId);
            if (existingItem) {
                existingItem.quantity += qty;
            } else {
                window.posCart.push({
                    variantId: window.selectedVariantId,
                    productId: @Model.Id,
                    name: '@Html.Raw(Model.Name.Replace("'", "\\'"))',
                    attributes: variant.attributes,
                    unitPrice: variant.price,
                    quantity: qty
                });
            }

            $('#productDetailsModal').modal('hide');
            
            if (typeof window.renderCart === 'function') {
                window.renderCart();
            }
        };

        // Initial check in case product has no attributes or only one variant
        window.updateVariantDetails();
    })();
</script>
