@model IEnumerable<POS_SYSTEM_MVC.Models.Product>

<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-3 flex-grow-1" style="overflow:auto;">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card border-0 product-card shadow-sm" onclick="openProductDetails(@product.Id)"
                 style="cursor: pointer; transition: all 0.2s ease; border-radius: 10px; overflow: hidden; background: #fff;">
                <div class="position-relative" style="aspect-ratio: 1 / 1; overflow: hidden; background-color: #fcfcfc;">
                    <img src="/images/products/@(product.Id).jpg" class="card-img-top w-100 h-100 @(product.Variants.All(v => v.StockQuantity <= 0) ? "opacity-50" : "")"
                         style="object-fit: cover; transition: transform 0.3s ease;" alt="@product.Name"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/300x300?text=@(Uri.EscapeDataString(product.Name))'">
                    
                    @if (product.Variants.All(v => v.StockQuantity <= 0))
                    {
                        <div class="position-absolute top-50 start-50 translate-middle w-100 text-center">
                            <span class="badge bg-danger px-3 py-2 shadow-sm fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">OUT OF STOCK</span>
                        </div>
                    }
                </div>
                <div class="card-body p-2 px-3">
                    <h6 class="card-title text-dark fw-bold mb-1 text-truncate" style="font-size: 0.85rem;" title="@product.Name">@product.Name</h6>
                    <p class="card-text text-primary fw-bold mb-0" style="font-size: 0.9rem;">$@product.BasePrice.ToString("F2")</p>
                </div>
            </div>
        </div>
    }
</div>

@if (ViewBag.TotalPages >= 1)
{
    <nav aria-label="Product navigation" class="mt-3 mb-0 mt-auto">
        <ul class="pagination pagination-rounded pagination-sm justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link shadow-sm pagination-link" href="#" data-page="@(ViewBag.CurrentPage - 1)">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link shadow-sm pagination-link" href="#" data-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link shadow-sm pagination-link" href="#" data-page="@(ViewBag.CurrentPage + 1)">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
