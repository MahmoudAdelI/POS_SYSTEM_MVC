@using Microsoft.AspNetCore.Identity
@using POS_SYSTEM_MVC.Constants
@using POS_SYSTEM_MVC.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isUserLoggedIn = SignInManager.IsSignedIn(User);
    var userRole = "Cashier"; // Default role
    var userName = "Guest";

    if (isUserLoggedIn)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            userName = String.Concat(user.FirstName, " ", user.LastName) ?? user.UserName ?? "User";
            var roles = await UserManager.GetRolesAsync(user);
            userRole = roles.FirstOrDefault() ?? "Cashier";
        }
    }
}

<nav id="sidebar">
    <div class="sidebar-header d-flex flex-column align-items-center justify-content-center py-4">
        <h4 class="mb-0 fw-bold">POS System</h4>
    </div>

    <div class="sidebar-content">
        <div class="user-profile px-3 py-2 mb-3">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 45px; height: 45px;">
                        <i class="fas fa-user text-white"></i>
                    </div>
                </div>
                <div class="flex-grow-1 ms-3 overflow-hidden">
                    <p class="mb-0 fw-bold text-truncate">@userName</p>
                    <span class="text-muted small">@userRole</span>
                </div>
            </div>
        </div>

        @{
            var currentPath = ViewContext.HttpContext.Request.Path.Value?.ToLowerInvariant() ?? "/";
        }

        @if (userRole == "admin")
        {
            <h6 class="category-label">Admin Panel</h6>
            <ul class="list-unstyled components">
                <li class="@((currentPath == "/admin" || currentPath.StartsWith("/admin/dashboard")) ? "active" : "")">
                    <a href="/Admin/Dashboard" class="ajax-link">
                        <i class="fas fa-chart-line fa-fw"></i>
                        <span class="ms-2">Dashboard</span>
                    </a>
                </li>
                <li class="@((currentPath.StartsWith("/products")) ? "active" : "")">
                    <a href="/products" class="ajax-link">
                        <i class="fas fa-cube fa-fw"></i>
                        <span class="ms-2">Products</span>
                    </a>
                </li>
                <li class="@((currentPath.StartsWith("/admin/inventory")) ? "active" : "")">
                    <a href="/Admin/Inventory" class="ajax-link">
                        <i class="fas fa-box fa-fw"></i>
                        <span class="ms-2">Inventory</span>
                    </a>
                </li>
                <li class="@((currentPath.StartsWith("/admin/discount")) ? "active" : "")">
                    <a href="/Admin/Discount" class="ajax-link">
                        <i class="fas fa-tag fa-fw"></i>
                        <span class="ms-2">Discounts</span>
                    </a>
                </li>
                <li class="@((currentPath.StartsWith("/admin/saleshistory")) ? "active" : "")">
                    <a href="/Admin/SalesHistory" class="ajax-link">
                        <i class="fas fa-receipt fa-fw"></i>
                        <span class="ms-2">Sales History</span>
                    </a>
                </li>
               
            </ul>
        }
        else
        {
            <h6 class="category-label">Category</h6>
            <ul class="list-unstyled components">
                <li class="@((currentPath.StartsWith("/cashier") || currentPath == "/") ? "active" : "")">
                    <a href="@Url.Action("Index", "Cashier")" class="ajax-link">
                        <span class="ms-2">All Products</span>
                    </a>
                </li>

                @await Component.InvokeAsync("SidebarCategory")
            </ul>
        }
    </div>

    <div class="sidebar-footer p-3">
        @if (isUserLoggedIn)
        {
            <a href="/Account/Logout" class="logout-link">
                <i class="fas fa-arrow-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        }
        else
        {
            <a href="/Account/Login" class="btn btn-primary w-100">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
        }
    </div>
</nav>

