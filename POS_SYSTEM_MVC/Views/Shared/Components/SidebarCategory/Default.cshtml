@model IEnumerable<POS_SYSTEM_MVC.Models.Category>
@{
    var currentStockFilter = ViewBag.StockFilter as string;
    var isAll = string.IsNullOrEmpty(currentStockFilter) || currentStockFilter == "all";
}

<li class="mb-3 px-3">
    <label class="form-label text-muted small fw-bold text-uppercase mb-2">Stock Availability</label>
    <div class="d-flex flex-column gap-1">
        <div class="form-check custom-sidebar-check">
            <input class="form-check-input stock-radio-filter" type="radio" name="stockFilterSide" id="stock_all" value="all" @(isAll ? "checked" : "")>
            <label class="form-check-label small" for="stock_all">All Products</label>
        </div>
        <div class="form-check custom-sidebar-check">
            <input class="form-check-input stock-radio-filter" type="radio" name="stockFilterSide" id="stock_in" value="inStock" @(currentStockFilter == "inStock" ? "checked" : "")>
            <label class="form-check-label small" for="stock_in">In Stock Only</label>
        </div>
        <div class="form-check custom-sidebar-check">
            <input class="form-check-input stock-radio-filter" type="radio" name="stockFilterSide" id="stock_out" value="outOfStock" @(currentStockFilter == "outOfStock" ? "checked" : "")>
            <label class="form-check-label small" for="stock_out">Out of Stock</label>
        </div>
    </div>
</li>

<li class="mb-2 px-3">
    <label class="form-label text-muted small fw-bold text-uppercase mb-0">Categories</label>
</li>

@foreach (var category in Model)
{
    <li>
        @if (category.SubCategories != null && category.SubCategories.Any())
        {
            <a href="#categorySubmenu_@category.Id" data-bs-toggle="collapse" aria-expanded="false">
                <span class="ms-2">@category.Name</span>
            </a>
            <ul class="collapse list-unstyled sidebar-submenu" id="categorySubmenu_@category.Id">
                @foreach (var sub in category.SubCategories)
                {
                    <li>
                        <a href="@Url.Action("Index", "Cashier", new { subCategoryId = sub.Id })" class="ajax-link">@sub.Name</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <a href="@Url.Action("Index", "Cashier", new { categoryId = category.Id })" class="ajax-link">
                <span class="ms-2">@category.Name</span>
            </a>
        }
    </li>
}
